{
  "manifest_version": 3,
  "name": "Dyslexia-Friendly Reading Engine",
  "description": "A premium accessibility tool that automatically improves web readability with smart content detection, customizable reading profiles, BeeLine gradients, reading ruler, and text-to-speech.",
  "version": "2.0.0",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Dyslexia-Friendly Reading Engine"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "utils/storage.js",
        "utils/detection.js",
        "contentScript.js"
      ],
      "css": [],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "toggle-extension": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Toggle reading mode on/off"
    },
    "toggle-ruler": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Toggle reading ruler"
    },
    "toggle-tts": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Start/stop text-to-speech"
    },
    "toggle-immersive": {
      "suggested_key": {
        "default": "Alt+Shift+I",
        "mac": "Alt+Shift+I"
      },
      "description": "Toggle immersive mode"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}